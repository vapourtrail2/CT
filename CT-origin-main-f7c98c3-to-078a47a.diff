+void CTViewer::closeEvent(QCloseEvent* event)
+{
+    isClosing_ = true;
+    setEnabled(false);
+    if (auto* modal = QApplication::activeModalWidget(); modal && modal != this && isAncestorOf(modal)) {
+        if (auto* dialog = qobject_cast<QDialog*>(modal)) dialog->reject();
+        event->ignore();
+        QTimer::singleShot(0, this, &QWidget::close);
+        return;
+    }
+    QString error;
+    bool workersStopped = true;
+    for (auto* dialog : findChildren<fdkui::OnlineReconstructionDialog*>()) workersStopped = dialog->Stop() && workersStopped;
+    for (const auto& thread : copyThreads_) workersStopped = (!thread || !thread->isRunning()) && workersStopped;
+    if (!workersStopped) {
+        event->ignore();
+        QTimer::singleShot(50, this, &QWidget::close);
+        return;
+    }
+    if (context_.getSessionManager().Stop(&error)) { event->accept(); return; }
+    event->ignore();
+    statusBar()->showMessage(QStringLiteral("正在停止 SDK：%1").arg(error));
+    QTimer::singleShot(50, this, &QWidget::close);
+}
