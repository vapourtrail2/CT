+bool SessionManager::Stop(QString* errorOut)
+{
+    if (!isClosing_) {
+        isClosing_ = true; ++requestGeneration_;
+        loadRetryTimer_.stop(); pendingLoad_.reset();
+    }
+    return StopHost(errorOut);
+}
